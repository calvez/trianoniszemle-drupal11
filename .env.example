# Copy to .env (git-ignored). On Laravel Forge paste these into Site -> Environment.
# One KEY=value per line; quote values that contain spaces.

# --- Required ----------------------------------------------------------------------
APP_ENV=production                     # "local" shows PHP errors; anything else hides them
DB_NAME=trianoniszemle
DB_USER=forge
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
# 64 random hex characters:  php -r 'echo bin2hex(random_bytes(32));'
HASH_SALT=
# Host names this site answers to (comma separated)
TRUSTED_HOSTS=trianoniszemle.hu,www.trianoniszemle.hu

# --- Optional ----------------------------------------------------------------------
# DB_PORT=3306
# DB_PREFIX=
# Private files (article PDFs) - must be OUTSIDE the web root. Default: <project>/private
# PRIVATE_FILES_PATH=/home/forge/trianoniszemle.hu/private
# Public files path relative to web/ (default sites/default/files). Useful with shared storage.
# PUBLIC_FILES_PATH=sites/default/files
# Behind a load balancer / CDN (comma separated IPs):
# REVERSE_PROXY_ADDRESSES=
# Site address for command line runs (cron, sitemap, e-mails); default is in drush/drush.yml
# DRUSH_OPTIONS_URI=https://trianoniszemle.hu

# --- Only while running the legacy migration (see docs/MIGRATION.md) ------------------------
# Where the old site's tables are: same DB with this prefix, or another database.
# LEGACY_DB_PREFIX=trn_
# LEGACY_DB_NAME=trianoniszemle_legacy
# LEGACY_DB_USER=
# LEGACY_DB_PASSWORD=
# The old site's files, copied to this server:
# LEGACY_FILES_PATH=/home/forge/legacy/files
# LEGACY_PRIVATE_PATH=/home/forge/legacy/private
# LEGACY_FALLBACK_FILES_PATH=

# --- Scripts -----------------------------------------------------------------------------
# scripts/backup-offsite.sh
# BACKUP_SSH_TARGET=user@host
# BACKUP_SSH_PORT=22
# BACKUP_SSH_KEY=/home/forge/.ssh/id_ed25519_backup
# BACKUP_REMOTE_DIR=trianoniszemle
# scripts/security-check.sh
# ALERT_EMAIL=you@example.com
